{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": ["node_modules/sql.js/dist/sql-wasm.wasm", "server/**"]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
